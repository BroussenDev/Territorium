# Territorium game server settings. `npm run dev` needs none of these: it
# runs with development values. Copy to .env for a local override.

# The site's domain (account tokens are issued for it).
DOMAIN=your-domain.com

# Account API origin. Leave empty for the default https://api.<DOMAIN>
# (http://localhost:8787 when DOMAIN=localhost). Set it when the API lives
# elsewhere, e.g. on a path of the game's own domain. No trailing slash.
API_URL=

# Key the game server uses to call the account API.
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Admin panel (/admin.html) for the homepage news feed. Leave empty to
# disable it. Use a long random password.
ADMIN_PASSWORD=
# Where admin-edited news are stored (default: data/news.json). Mount it on a
# persistent volume in production.
NEWS_FILE=
